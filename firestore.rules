rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Admin access is granted with Firebase custom claims from a trusted Admin SDK environment.
    // Never assign this claim from browser code or from a user-editable Firestore field.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isConversationMember(conversationId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    function profileDisplayName(uid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(uid))
        ? get(/databases/$(database)/documents/publicProfiles/$(uid)).data.displayName
        : get(/databases/$(database)/documents/users/$(uid)).data.profileData.displayName;
    }
    function canDirectMessage(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return conversation.isGroup == true
        || (conversation.participants.size() == 2 && directMessageParticipantsAreNotBlocked(conversation));
    }
    function directMessageParticipantsAreNotBlocked(conversation) {
      let otherUid = conversation.participants[0] == request.auth.uid
        ? conversation.participants[1]
        : conversation.participants[0];
      let sender = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let recipient = get(/databases/$(database)/documents/users/$(otherUid)).data;
      return !(otherUid in sender.get('blockedUsers', []))
        && !(request.auth.uid in recipient.get('blockedUsers', []));
    }

    match /hackathons/{eventId} {
      allow read: if resource.data.visibility == 'public' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Private account record. Email/phone source values and private profile snapshots stay here; only opt-in contact fields are copied to publicProfiles.
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.role == 'participant';
      allow update: if isSelf(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isSelf(userId);

      match /savedEvents/{eventId} {
        allow read, create, delete: if isSelf(userId);
        allow update: if false;
      }
      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create: if signedIn()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.keys().hasOnly([
            'type','category','title','body','actorUid','actorName','conversationId',
            'conversationName','invitationId','targetHash','actionLabel','eventId','profileUid','expiresAt','createdAt','read'
          ])
          && (
            (request.resource.data.type == 'team_invite'
              && request.resource.data.invitationId is string
              && exists(/databases/$(database)/documents/teamInvitations/$(request.resource.data.invitationId))
              && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.invitationId)).data.fromUid == request.auth.uid
              && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.invitationId)).data.toUid == userId)
            ||
            (request.resource.data.type == 'team_invite_response'
              && request.resource.data.invitationId is string
              && exists(/databases/$(database)/documents/teamInvitations/$(request.resource.data.invitationId))
              && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.invitationId)).data.fromUid == userId
              && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.invitationId)).data.toUid == request.auth.uid
              && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.invitationId)).data.status in ['accepted','declined'])
            ||
            (request.resource.data.type == 'chat_message'
              && request.resource.data.conversationId is string
              && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
              && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
              && userId in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
              && userId != request.auth.uid)
            ||
            (request.resource.data.type in ['group_deleted','team_deleted']
              && request.resource.data.conversationId is string
              && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
              && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.createdBy == request.auth.uid
              && userId in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants)
          );
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow delete: if isSelf(userId);
      }
    }

    // Public, searchable member directory. The client writes a curated whitelist of fields.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid','displayName','nameLower','username','usernameLower','college','collegeLower',
          'course','courseLower','collegeShort','collegeShortLower','studyLevel','graduationYear','city','country','bio','skills','skillsLower',
          'rolesInterested','rolesLower','interests','interestsLower','availability','preferredMode','avatarUrl','profileVisibility',
          'github','linkedin','portfolio','lookingForTeam','publicEmail','publicEmailLower','publicPhone','publicPhoneDigits','skillLevel','tracks','profileConsentAt','updatedAt'
        ])
        && request.resource.data.profileVisibility == 'public'
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.size() >= 3
        && request.resource.data.usernameLower.size() <= 24
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.skills is list
        && request.resource.data.skills.size() <= 30;
      allow delete: if isSelf(userId);
    }

    // Username reservation documents prevent two accounts taking the same handle.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // Direct messages and groups. New group members can join only through an invitation acceptance.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'isGroup','entityType','groupName','participants','participantNames','lastMessage',
          'createdAt','updatedAt','lastMessageAt','createdBy','admins','lastMessageSender','requiredSkills','teamSize','availability','preferredLevel','teamCollege','teamYear','teamCourse','teamLocation','teamHackathon','teamCommunication','teamVisibility','teamJoinMode','teamDescription','teamIdea'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 10
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.isGroup is bool
        && (request.resource.data.isGroup == false
          ? request.resource.data.participants.size() == 2
          : request.resource.data.participants.size() == 1
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.entityType in ['group','team']
            && request.resource.data.admins is list
            && request.auth.uid in request.resource.data.admins);
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.participants && (
          (request.resource.data.participants == resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage','lastMessageSender','lastMessageAt','updatedAt'
            ]))
          ||
          (resource.data.isGroup == true
            && (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.admins)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.admins == resource.data.admins
            && request.resource.data.participants is list
            && request.resource.data.participants.size() >= 1
            && request.resource.data.participants.size() <= 10
            && request.resource.data.participants.size() <= resource.data.get('teamSize', 10)
            && resource.data.createdBy in request.resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participants','participantNames','updatedAt'
            ]))
          ||
          (resource.data.isGroup == true
            && request.auth.uid in resource.data.participants
            && request.auth.uid != resource.data.createdBy
            && !(request.auth.uid in resource.data.admins)
            && !(request.auth.uid in request.resource.data.participants)
            && request.resource.data.participants is list
            && request.resource.data.participants.size() == resource.data.participants.size() - 1
            && resource.data.createdBy in request.resource.data.participants
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.admins == resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participants','participantNames','updatedAt'
            ])))
        )
        ||
        (resource.data.isGroup == true
          && !(request.auth.uid in resource.data.participants)
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() == resource.data.participants.size() + 1
          && request.resource.data.participants.size() <= 10
          && request.resource.data.participants.size() <= resource.data.get('teamSize', 10)
          && request.resource.data.lastAcceptedInviteId is string
          && exists(/databases/$(database)/documents/teamInvitations/$(request.resource.data.lastAcceptedInviteId))
          && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.lastAcceptedInviteId)).data.conversationId == conversationId
          && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.lastAcceptedInviteId)).data.toUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/teamInvitations/$(request.resource.data.lastAcceptedInviteId)).data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'participants','participantNames','updatedAt','lastAcceptedInviteId'
          ]))
      );
      allow delete: if signedIn() && resource.data.isGroup == true && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.authorName == profileDisplayName(request.auth.uid)
          && canDirectMessage(conversationId)
          && request.resource.data.keys().hasOnly(['authorUid','authorName','text','createdAt','replyTo']);
        allow update: if isConversationMember(conversationId) && (
          (resource.data.authorUid == request.auth.uid
            && request.time < resource.data.createdAt + duration.value(15, 'm')
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text','edited','editedAt','deleted','deletedAt'
            ])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionsByUser'])
            && request.resource.data.reactionsByUser is map
            && request.resource.data.reactionsByUser.diff(resource.data.get('reactionsByUser', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.reactionsByUser.get(request.auth.uid, []).size() <= 4
            && request.resource.data.reactionsByUser.get(request.auth.uid, []).hasOnly(['👍','❤️','😂','🎉']))
        );
        allow delete: if isConversationMember(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid;
      }
    }

    match /teamInvitations/{invitationId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.conversationId is string
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && (get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.createdBy == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.admins)
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.isGroup == true
        && !(request.resource.data.toUid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants)
        && request.resource.data.entityType in ['group','team']
        && request.resource.data.teamSize is int
        && request.resource.data.teamSize >= 2
        && request.resource.data.teamSize <= 10
        && !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.get('blockedUsers', []))
        && request.resource.data.keys().hasOnly([
          'conversationId','conversationName','entityType','fromUid','fromName','toUid','toName',
          'requiredSkills','teamSize','status','createdAt','expiresAt'
        ]);
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.time < resource.data.expiresAt
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']);
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.conversationId is string
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.createdBy == request.auth.uid
        && request.resource.data.action in ['group_deleted','team_deleted'];
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if resource.data.visibility == 'public' ||
        (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid','ownerName','title','description','techStack','projectUrl',
          'githubUrl','visibility','createdAt','updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && request.resource.data.visibility in ['public','private'];
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 1000
        && request.resource.data.keys().hasOnly(['createdBy','targetUid','targetName','category','details','status','createdAt']);
      allow read, update, delete: if isAdmin();
    }
    match /discoverySources/{sourceId} {
      allow read: if isAdmin();
      allow write: if false; // Managed by trusted Cloud Functions only.
    }
    match /eventFingerprints/{fingerprintId} {
      allow read, write: if isAdmin();
    }
    match /sourceItems/{sourceId} {
      allow read, write: if isAdmin();
    }
    match /ingestionRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
