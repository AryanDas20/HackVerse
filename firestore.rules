rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Admin access is granted with Firebase custom claims from a trusted Admin SDK environment.
    // Never assign this claim from browser code or from a user-editable Firestore field.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isConversationMember(conversationId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    function profileDisplayName(uid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(uid))
        ? get(/databases/$(database)/documents/publicProfiles/$(uid)).data.displayName
        : get(/databases/$(database)/documents/users/$(uid)).data.profileData.displayName;
    }
    function ownsAiConversation(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/aiConversations/$(conversationId))
        && get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.ownerUid == request.auth.uid;
    }

    match /hackathons/{eventId} {
      // Opportunity details are members-only. Admins can still read all listings.
      allow read: if signedIn() && (resource.data.visibility == 'public' || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Private account record. Email/phone source values and private profile snapshots stay here; only opt-in contact fields are copied to publicProfiles.
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.role == 'participant';
      allow update: if isSelf(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isSelf(userId);

      match /savedEvents/{eventId} {
        allow read, create, delete: if isSelf(userId);
        allow update: if false;
      }
      match /notifications/{notificationId} {
        allow read, update: if isSelf(userId);
        allow create, delete: if false;
      }
    }

    // Public, searchable member directory. The client writes a curated whitelist of fields.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid','displayName','nameLower','username','usernameLower','college','collegeLower','statusText','joinedAt',
          'course','courseLower','collegeShort','collegeShortLower','studyLevel','graduationYear','city','country','bio','skills','skillsLower',
          'rolesInterested','rolesLower','interests','interestsLower','availability','preferredMode','avatarUrl','profileVisibility',
          'github','linkedin','portfolio','lookingForTeam','publicEmail','publicEmailLower','publicPhone','publicPhoneDigits','profileConsentAt','updatedAt'
        ])
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.size() >= 3
        && request.resource.data.usernameLower.size() <= 24
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.skills is list
        && request.resource.data.skills.size() <= 30;
      allow delete: if isSelf(userId);
    }

    // Username reservation documents prevent two accounts taking the same handle.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // Direct messages and group chats. Group owners/admins can manage membership.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'isGroup','groupName','groupDescription','groupPhotoUrl','participants','participantNames','lastMessage',
          'createdAt','updatedAt','lastMessageAt','createdBy','admins','lastMessageSender'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 11
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.isGroup is bool
        && (request.resource.data.isGroup == false || (
          request.resource.data.createdBy == request.auth.uid
          && request.resource.data.admins is list
          && request.auth.uid in request.resource.data.admins
        ));
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && (
          (request.resource.data.participants == resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage','lastMessageSender','lastMessageAt','updatedAt'
            ]))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAtBy'])
            && request.resource.data.readAtBy is map
            && request.resource.data.readAtBy.diff(resource.data.get('readAtBy', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.readAtBy.get(request.auth.uid, null) is timestamp)
          ||
          (resource.data.isGroup == true
            && request.auth.uid == resource.data.createdBy
            && request.resource.data.deleted == true
            && request.resource.data.deletedBy == request.auth.uid
            && request.resource.data.deletionNote is string
            && request.resource.data.deletionNote.size() >= 8
            && request.resource.data.deletionNote.size() <= 300
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deleted','deletedBy','deletionNote','deletedAt','updatedAt'
            ]))
          ||
          (resource.data.isGroup == true
            && (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.admins)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.admins == resource.data.admins
            && request.resource.data.participants is list
            && request.resource.data.participants.size() >= 2
            && request.resource.data.participants.size() <= 11
            && resource.data.createdBy in request.resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participants','participantNames','groupName','groupDescription','groupPhotoUrl','updatedAt'
            ]))
          || (resource.data.isGroup == true
            && request.auth.uid == resource.data.createdBy
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.admins is list
            && request.resource.data.createdBy in request.resource.data.admins
            && request.resource.data.admins.toSet().hasOnly(request.resource.data.participants.toSet())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins','updatedAt']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenForBy'])
            && request.resource.data.hiddenForBy is map
            && request.resource.data.hiddenForBy.diff(resource.data.get('hiddenForBy', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.hiddenForBy.get(request.auth.uid, null) is timestamp)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearAtBy'])
            && request.resource.data.clearAtBy is map
            && request.resource.data.clearAtBy.diff(resource.data.get('clearAtBy', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.clearAtBy.get(request.auth.uid, null) is timestamp)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAtBy'])
            && request.resource.data.deliveredAtBy is map
            && request.resource.data.deliveredAtBy.diff(resource.data.get('deliveredAtBy', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.deliveredAtBy.get(request.auth.uid, null) is timestamp)
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 || ('attachment' in request.resource.data && request.resource.data.attachment is map))
          && request.resource.data.authorName == profileDisplayName(request.auth.uid)
          && request.resource.data.keys().hasOnly(['authorUid','authorName','text','createdAt','kind','attachment','replyTo','forwarded'])
          && (!('attachment' in request.resource.data) || (
            request.resource.data.attachment is map
            && request.resource.data.attachment.keys().hasOnly(['name','type','size','storagePath'])
            && request.resource.data.attachment.name is string
            && request.resource.data.attachment.name.size() <= 120
            && request.resource.data.attachment.type is string
            && request.resource.data.attachment.storagePath is string
            && request.resource.data.attachment.storagePath.size() <= 300
            && request.resource.data.attachment.storagePath.matches('chat-media/' + conversationId + '/' + request.auth.uid + '/.*')
            && request.resource.data.attachment.size <= 15728640
          ))
          && (!('replyTo' in request.resource.data) || request.resource.data.replyTo.keys().hasOnly(['messageId','authorName','text']))
          && (!('kind' in request.resource.data) || request.resource.data.kind in ['text','image','video','audio','voice','file'])
          && (!('forwarded' in request.resource.data) || request.resource.data.forwarded is bool);
        allow update: if isConversationMember(conversationId) && (
          (resource.data.authorUid == request.auth.uid
            && request.time < resource.data.createdAt + duration.value(15, 'm')
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','editedAt','deleted','deletedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map
            && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.reactions.get(request.auth.uid, '') in ['', '👍','❤️','😂','😮','😢','🔥','🎉','🤝','🚀'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','deleted','deletedAt'])
            && request.resource.data.deleted == true
            && request.resource.data.text == 'This message was deleted.'
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.authorName == resource.data.authorName
            && request.time < resource.data.createdAt + duration.value(60, 'm')
            && (resource.data.authorUid == request.auth.uid
              || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.isGroup == true
                && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid
                  || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.admins))))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenForBy'])
            && request.resource.data.hiddenForBy is map
            && request.resource.data.hiddenForBy.diff(resource.data.get('hiddenForBy', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.hiddenForBy.get(request.auth.uid, false) == true)
        );
        allow delete: if false;
      }
      match /typing/{userId} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isSelf(userId) && isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['uid','displayName','updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.displayName is string
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isSelf(userId) && isConversationMember(conversationId);
      }
    }

    // Private Agent37 conversation history. Only its owner can read or write it.
    match /aiConversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid','title','preview','mode','agentSessionId','createdAt','updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 160
        && request.resource.data.mode in ['chat','wish']
        && request.resource.data.agentSessionId == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','preview','mode','updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 160
        && request.resource.data.mode in ['chat','wish']
        && request.resource.data.updatedAt is timestamp;

      match /messages/{messageId} {
        allow read, delete: if ownsAiConversation(conversationId);
        allow create: if ownsAiConversation(conversationId)
          && request.resource.data.keys().hasOnly(['role','content','createdAt'])
          && request.resource.data.role in ['user','assistant']
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 12000;
        allow update: if false;
      }
    }

    // Daily AI usage is counted only by the trusted Vercel API route.
    match /aiUsageDaily/{usageId} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read: if resource.data.visibility == 'public' ||
        (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid','ownerName','title','description','techStack','projectUrl',
          'githubUrl','visibility','createdAt','updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && request.resource.data.visibility in ['public','private'];
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 1000
        && request.resource.data.keys().hasOnly(['createdBy','targetUid','targetName','category','details','status','createdAt']);
      allow read, update, delete: if isAdmin();
    }
    match /discoverySources/{sourceId} {
      allow read: if isAdmin();
      allow write: if false; // Managed by trusted Cloud Functions only.
    }
    match /eventFingerprints/{fingerprintId} {
      allow read, write: if isAdmin();
    }
    match /sourceItems/{sourceId} {
      allow read, write: if isAdmin();
    }
    match /ingestionRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
