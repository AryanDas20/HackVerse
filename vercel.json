{
  "outputDirectory": "public",
  "functions": {
    "api/agent37/chat.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/pitch-arena",
      "destination": "/api/agent37/chat?action=pitch-arena"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/payu-recurring-cron",
      "schedule": "0 3 * * *"
    }
  ]
}
