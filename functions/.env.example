# Copy to functions/.env.<your-firebase-project-id> and keep it out of Git.
# Only public RSS/Atom feeds whose terms permit this use. Comma-separated.
HACKVERSE_RSS_FEEDS=

# Optional. Google Cloud Console -> enable YouTube Data API v3 -> create an API key.
# Restrict this key to YouTube Data API v3. Do not put it in public/ JavaScript.
HACKVERSE_YOUTUBE_API_KEY=
HACKVERSE_YOUTUBE_QUERIES=hackathon registration;student hackathon;hackathon challenge
